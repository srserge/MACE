# Todo el contenido binario de Unreal por LFS
Content/** filter=lfs diff=lfs merge=lfs -text
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.uptnl   filter=lfs diff=lfs merge=lfs -text

# Los ficheros de texto del proyecto NO deben ir a LFS
*.uproject  -filter -diff -merge text
*.ini       -filter -diff -merge text
*.cs        -filter -diff -merge text
*.cpp       -filter -diff -merge text
*.h         -filter -diff -merge text
